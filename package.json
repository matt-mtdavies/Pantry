{
  "name": "pantry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler pages dev dist --d1 DB --r2 R2 --port 8788",
    "db:migrate:local": "wrangler d1 execute pantry-db --local --file=./migrations/0001_schema.sql",
    "db:migrate:remote": "wrangler d1 execute pantry-db --file=./migrations/0001_schema.sql"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.21.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wrangler": "^3.74.0"
  }
}
